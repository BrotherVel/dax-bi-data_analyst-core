	partition Dim_Product = m
		mode: import
		source =
				let
				  Origem = Sql.Database("localhost", "AdventureWorksDW2025", [Query = "SELECT [ProductKey]#(lf)      ,[ProductAlternateKey]#(lf)      ,[ProductSubcategoryKey]#(lf)      ,[EnglishProductName]#(lf)      ,[StandardCost]#(lf)      ,[Color]#(lf)      ,[ListPrice]#(lf)      ,[DaysToManufacture]#(lf)      ,[ModelName]#(lf)      ,[EnglishDescription]#(lf)  FROM [AdventureWorksDW2025].[dbo].[DimProduct]#(lf)  WHERE FinishedGoodsFlag = 1"])
				in
